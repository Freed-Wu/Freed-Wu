set my_addr = $my_gmail

set folder = $my_imap_gmail
set imap_user = `$my_pass show neomutt/user/gmail`
set imap_pass = `$my_pass show neomutt/pass/gmail`

set from = $imap_user
# gnutls_handshake: The TLS connection was non-properly terminated.
set smtp_url = smtps://$from@smtp.$my_addr
set smtp_pass = $imap_pass

set my_spool_file = Inbox
set my_postponed = '[Gmail]/Drafts'
set my_record = '[Gmail]/Sent Mail'
set my_trash = '[Gmail]/Trash'
set spool_file = +$my_spool_file
set postponed = +$my_postponed
set record = +$my_record
set trash = +$my_trash
unmailboxes *
named-mailboxes $my_spool_file_icon$my_spool_file $spool_file
set my_folder = '[Gmail]'
# IMAP command failed: c0177 NO [NONEXISTENT] Invalid folder: [Gmail] (Failure)
# named-mailboxes $my_folder_icon$my_folder +$my_folder
mailboxes $postponed $record $trash \
+[Gmail]/Spam +[Gmail]/Starred +[Gmail]/Important '+[Gmail]/All Mail'
